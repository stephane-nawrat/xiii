# ==========================================
# XIII Backend - Environment Variables Template
# ==========================================
# Copier ce fichier en .env et remplir avec vos valeurs

# === MySQL Configuration ===
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
DB_NAME=xiii_db
DB_USER=xiii_admin
DB_PASSWORD=your_mysql_user_password_here

# === API Configuration ===
NODE_ENV=development
API_PORT=3001

# === JWT Secret ===
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
